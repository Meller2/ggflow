# Normalize line endings: LF in the repository, native in the working tree.
# The index is already pure LF — this only makes it independent of each
# contributor's core.autocrlf setting (Windows-first project, mixed tooling).
* text=auto eol=lf

# Windows scripts must keep CRLF to stay runnable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch these.
*.png binary
*.ico binary
*.icns binary
*.gguf binary
*.zip binary
*.exe binary
*.sig binary

# Collapse generated lockfiles in GitHub diffs / language stats.
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
